# ======================
# Voice Gateway
# ======================
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://voice.survivalsculk.biz.id

MINECRAFT_SERVER_NAME=SurvivalSculk

# Generate: openssl rand -hex 32
MINECRAFT_CONNECTOR_SECRET=ganti_dengan_secret_panjang_dan_acak
SESSION_SECRET=ganti_dengan_secret_lain_yang_panjang

WEBSOCKET_PATH=/ws

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PROXIMITY_ENABLED=true
PROXIMITY_MAX_DISTANCE=32
PROXIMITY_MIN_DISTANCE=2
PROXIMITY_FALLOFF=true
PROXIMITY_SAME_DIMENSION_ONLY=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_TTL_SECONDS=3600
TOKEN_TTL_SECONDS=300
